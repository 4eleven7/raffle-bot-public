# Copy to .env. Every value is optional. The bot runs without alerts if the Telegram values are empty.

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Codex CLI features. Leave at 0 unless the `codex` command is installed and logged in.
RAFFLE_BOT_ALERT_REVIEWER=0
RAFFLE_BOT_LLM_VALUATION=0
# RAFFLE_BOT_CODEX_COMMAND=codex

# Public Supabase anon keys, needed only to scan these six sites.
# Each site publishes its key in its own web client. Other sites need no key.
INITTOWINIT_SUPABASE_ANON_KEY=
PHASE_SUPABASE_ANON_KEY=
VAULTNINE_SUPABASE_ANON_KEY=
QUIDSINCOMPS_SUPABASE_ANON_KEY=
TECHDROP_SUPABASE_ANON_KEY=
CASHGRAB_SUPABASE_ANON_KEY=

# Optional paths. The defaults are ./raffle-bot.config.json and ./data/.
# RAFFLE_BOT_CONFIG=./raffle-bot.config.json
# RAFFLE_BOT_DB_PATH=./data/competitions.db
