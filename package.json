{
  "name": "raffle-bot",
  "version": "1.0.0",
  "description": "Monitor UK prize-raffle sites and rank raffles by expected value",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "raffle-bot": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc",
    "test": "node --env-file=tests/test.env --import tsx --test-concurrency=1 --test 'tests/**/*.test.ts'",
    "scan": "node --env-file-if-exists=.env --import tsx src/index.ts scan",
    "watch": "node --env-file-if-exists=.env --import tsx src/index.ts watch",
    "list": "node --env-file-if-exists=.env --import tsx src/index.ts list",
    "replay:alerts": "node --env-file-if-exists=.env --import tsx src/index.ts replay-alerts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "luxon": "^3.7.2",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "license": "MIT"
}
